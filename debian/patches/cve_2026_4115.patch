Description: Fix CVE-2026-4115: EdDSA verification accepts signatures with overlarge s value
 The integer s in an EdDSA signature is treated as an exponent. RFC 8032 requires
 s to be strictly less than the order of the curve's base point. This patch adds
 a check to reject signatures where s is out of range.
Author: Simon Tatham <anakin@pobox.com>
Origin: upstream, https://git.tartarus.org/?p=simon/putty.git;a=commitdiff;h=af996b5ec27ab79bae3882071b9d6acf16044549
Bug: https://security-tracker.debian.org/tracker/CVE-2026-4115
Forwarded: not-needed
---
 crypto/ecc-ssh.c | 5 +++++
 1 file changed, 5 insertions(+)

--- a/crypto/ecc-ssh.c
+++ b/crypto/ecc-ssh.c
@@ -1091,6 +1091,11 @@ static bool eddsa_verify(ssh_key *key, ptrlen sig, ptrlen data)
     if (!r)
         return false;
     mp_int *s = mp_from_bytes_le(sstr);
+    if (mp_cmp_hs(s, ek->curve->e.G_order)) {
+        ecc_edwards_point_free(r);
+        mp_free(s);
+        return false;
+    }
 
     mp_int *H = eddsa_signing_exponent_from_data(ek, extra, rstr, data);
 
